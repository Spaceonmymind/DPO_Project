# Application
APP_ENV=staging
APP_BASE_URL=https://dpo.example.internal
APP_PORT=5173
APP_SECRET_KEY=replace-with-at-least-32-random-characters
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=dpo
POSTGRES_USER=dpo
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# Sessions and login protection
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
SEED_DEMO_USERS=true

# Documents
DOCUMENT_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=20

# LLM
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_CONCURRENCY=5
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_STRUCTURED_OUTPUT_MODE=prompt
LLM_CONTEXT_MAX_TOKENS=16000
LLM_HISTORY_MAX_MESSAGES=30
LLM_EXTERNAL_DATA_TRANSFER=false
LLM_PROVIDER_IS_INTERNAL=false

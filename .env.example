AUTH_PROVIDER=mock
LLM_PROVIDER=mock
LLM_MODEL=qwen
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENT_REQUESTS=5
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_STRUCTURED_OUTPUT_MODE=prompt
LLM_CONTEXT_MAX_TOKENS=16000
LLM_HISTORY_MAX_MESSAGES=30
LLM_LOG_CONTENT=false
LLM_EXTERNAL_DATA_TRANSFER=false
LLM_PROVIDER_IS_INTERNAL=false
DATABASE_URL=postgresql+psycopg://dpo:dpo@db:5432/dpo
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=20
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
